# --- Secrets / environment ---
.env
.env.*.local
*.pem
*.key
kaggle.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# --- Run logs / Kaggle outputs ---
auto_runner_logs/
kaggle_outputs/
*.log

# --- Build outputs / release binaries (APK is >100 MB; share via GitHub Releases) ---
*.apk
*.aab

# --- Model weights ---
# Pretrained YOLO checkpoints are auto-downloaded by ultralytics.
*.pt
# Exported YOLO files at repo root (the app's copy lives in CowWeightApp/app/src/main/assets/)
/*.onnx
/*.tflite
yolov8n_saved_model/

# --- Local test images, documents and reports (keep them out of the repo) ---
*.jpg
*.jpeg
*.png
*.avif
*.webp
*.pdf
*.docx
batch_results.csv

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- Claude Code local config ---
.claude/settings.local.json
